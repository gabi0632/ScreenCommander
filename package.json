{
  "name": "screen-commander",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-display streaming management system for Windows",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=!@screen-commander/kiosk --filter=!@screen-commander/service",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "service:install": "pnpm build && node packages/service/dist/install-service.js",
    "service:uninstall": "node packages/service/dist/uninstall-service.js",
    "service:status": "node packages/service/dist/service-status.js",
    "kiosk:dev": "pnpm --filter @screen-commander/kiosk dev",
    "kiosk:build": "pnpm --filter @screen-commander/kiosk build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
